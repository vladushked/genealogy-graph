{
  "name": "genealogy-graph",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && node esbuild.config.mjs",
    "dev": "node esbuild.config.mjs dev",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test/e2e",
    "test": "npm run test:unit && npm run test:vault",
    "test:unit": "node --import tsx --test test/unit/*.test.ts",
    "test:vault": "node --import tsx --test test/vault/*.test.ts",
    "test:e2e": "npm run build && wdio run ./wdio.conf.mts",
    "lint": "eslint src",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "media": "npm run build && wdio run ./wdio.media.conf.mts && node docs/media/assemble.mjs"
  },
  "dependencies": {
    "d3-force": "^3.0.0",
    "jspdf": "^4.2.1",
    "sql.js": "^1.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@eslint/json": "^0.14.0",
    "@types/d3-force": "^3.0.10",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.0.0",
    "@types/sql.js": "^1.4.11",
    "@wdio/cli": "^9.32.0",
    "@wdio/globals": "^9.31.3",
    "@wdio/local-runner": "^9.32.0",
    "@wdio/mocha-framework": "^9.32.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "globals": "^17.13.0",
    "obsidian": "^1.8.7",
    "tsx": "^4.0.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.71.2",
    "wdio-obsidian-reporter": "^3.3.0",
    "wdio-obsidian-service": "^3.3.0",
    "webdriverio": "^9.32.0",
    "yaml": "^2.9.1"
  },
  "description": "Interactive genealogy graph from person note properties, with image and print export.",
  "license": "MIT"
}
